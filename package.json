{
  "name": "edgegate",
  "version": "1.0.0",
  "private": true,
  "description": "Edge-based distributed rate limiting with lease-based global coordination",
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=20" },
  "scripts": {
