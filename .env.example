# MongoDB is the coordinator's durable global state store.
# For Atlas, replace this with the connection string from your cluster.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=edgegate
LOG_LEVEL=info
DEV_CONTROL_PORT=4300
NODE_RESTART_DELAY_MS=1500

# Demo origin credentials (change these outside local development).
DEMO_LOGIN_EMAIL=demo@edgegate.dev
DEMO_LOGIN_PASSWORD=change-me

ORIGIN_PORT=4100
COORDINATOR_PORT=4000

# Edge defaults; bin/dev.js overrides these per node
EDGE_ID=edge-mumbai
EDGE_PORT=4201
EDGE_PEERS=3
EDGE_SYNC_INTERVAL_MS=1000
EDGE_SYNC_LATENCY_MS=0
EDGE_SYNC_JITTER_MS=0
EDGE_SYNC_LOSS_RATE=0
# bounded | open | closed
EDGE_FAIL_MODE=bounded
