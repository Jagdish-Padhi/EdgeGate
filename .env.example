# Global state store: "mongo" or "memory" (memory loses usage on coordinator restart)
STORE=mongo
# For Atlas, replace this with the connection string from your cluster.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=edgegate

ORIGIN_PORT=4100
COORDINATOR_PORT=4000

# Edge defaults; bin/dev.js overrides these per node
EDGE_ID=edge-mumbai
EDGE_PORT=4201
EDGE_PEERS=3
EDGE_SYNC_INTERVAL_MS=1000
EDGE_SYNC_LATENCY_MS=0
EDGE_SYNC_JITTER_MS=0
EDGE_SYNC_LOSS_RATE=0
# bounded | open | closed
EDGE_FAIL_MODE=bounded
